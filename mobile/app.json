{
  "expo": {
    "name": "StreamNyaa",
    "slug": "streamnyaa-android",
    "version": "0.7.0",
    "icon": "../desktop/src-tauri/icons/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "streamnyaa",
    "platforms": ["android"],
    "android": {
      "package": "com.misfit1000.streamnyaa",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "../desktop/src-tauri/icons/icon.png",
        "backgroundColor": "#030304"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "streamnyaa" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030304",
          "image": "../desktop/src-tauri/icons/icon.png",
          "imageWidth": 104,
          "dark": {
            "backgroundColor": "#030304",
            "image": "../desktop/src-tauri/icons/icon.png"
          }
        }
      ],
      ["expo-navigation-bar", { "hidden": true, "style": "light", "enforceContrast": false }],
      "expo-secure-store",
      ["expo-notifications", { "defaultChannel": "airing-reminders" }],
      ["expo-video", { "supportsPictureInPicture": true }],
      "./modules/torrent-engine/app.plugin.js"
    ],
    "extra": {
      "apiOrigin": "https://www.streamnyaa.xyz"
    }
  }
}
