{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamNyaa",
  "version": "0.1.1",
  "identifier": "xyz.streamnyaa.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm.cmd run prepare:desktop-binaries",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StreamNyaa",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' https: http://localhost:*; font-src 'self' data:; media-src 'self' blob: http://localhost:*; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["streamnyaa"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "bin/**/*"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
