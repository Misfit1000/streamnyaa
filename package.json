{
  "name": "streamnyaa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:desktop": "npm run build:desktop && node scripts/serve-desktop-dist.mjs",
    "preflight:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\check-desktop-tooling.ps1",
    "desktop:dev": "npm run preflight:desktop && cd desktop/src-tauri && cargo tauri dev",
    "desktop:build": "npm run preflight:desktop && powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-desktop-tauri.ps1",
    "start": "node dist/server.cjs",
    "build": "npm run generate:sitemap && vite build --config vite.config.mjs --configLoader native",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-desktop-fallback.ps1",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --outfile=dist/server.cjs --format=cjs",
    "build:local": "npm run build && npm run build:server",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "prepare:desktop-binaries": "node scripts/prepare-desktop-binaries.mjs",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\desktop\\run.ps1",
    "test:desktop-controls": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\desktop\\player-controls.ps1",
    "test:desktop-soak": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\desktop\\player-controls.ps1 -SoakCycles 100",
    "test:desktop-stall": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\desktop\\stalled-stream.ps1",
    "test:desktop-state": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tests\\desktop\\player-state.ps1",
    "test:frontend": "vitest run --config vitest.config.ts",
    "verify:desktop": "npm run lint && npm run test:frontend && npm run test:desktop && npm run test:desktop-state && npm run test:desktop-controls && npm run test:desktop-stall && npm run test:desktop-soak && cargo test --manifest-path .\\desktop\\src-tauri\\Cargo.toml",
    "verify:desktop-release": "npm run preflight:desktop && npm run prepare:desktop-binaries && npm run verify:desktop",
    "prepare:desktop-release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\prepare-desktop-release.ps1",
    "release:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-desktop-release.ps1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.99.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "fast-xml-parser": "^5.7.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "vite": "^6.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
